{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "apk": {
      "extends": "production",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "autoIncrement": false
    }
  },

  "submit": {
    "production": {
      "android": {
        "track": "beta",
        "releaseStatus": "completed"
      }
    }
  }
}
