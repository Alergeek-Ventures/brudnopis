{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "device-info": ["./src/native-modules/device-info"],
      "drawing-canvas": ["./src/native-modules/drawing-canvas"],
      "ink-recognition": ["./src/native-modules/ink-recognition"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "src/types/**/*.d.ts"]
}
